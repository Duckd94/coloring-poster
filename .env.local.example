# OpenAI — model gpt-image-2.5-sunburst (KHÔNG dùng gpt-image-1, đã deprecated)
OPENAI_API_KEY=

# fal.ai — fallback upscale khi Upscayl (local, cần GPU/Vulkan) không khả dụng
FAL_KEY=

# Gelato print-on-demand
GELATO_API_KEY=

# PayPal (stub ở giai đoạn đầu — xem PROJECT_BRIEF.md mục 7)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Supabase — URL và ANON_KEY cần prefix NEXT_PUBLIC_ vì được dùng ở browser client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVICE_ROLE_KEY chỉ dùng server-side (bypass RLS) — không thêm NEXT_PUBLIC_, không bao giờ lộ ra client
SUPABASE_SERVICE_ROLE_KEY=
